@@ -0,0 +1,77 @@
+using System.Globalization;
+using System.Text.Json;
+
+namespace RmsCollector;
+
+internal sealed record Reading(bool Ok = false, int Code = -1, string Error = "unavailable", string Raw = "");
+internal sealed record OperatingReading(string Type, Reading Result, long? Seconds);
+
+internal sealed class RobotSample
+{
+    public Reading Position { get; set; } = new();
+    public Reading Torque { get; set; } = new();
+    public Reading Alarm { get; set; } = new();
+    public Reading State { get; set; } = new();
+    public Reading Job { get; set; } = new();
+    public Reading Io { get; set; } = new();
+    public Reading AlarmHistory { get; set; } = new();
+    public double[] Pulses { get; set; } = new double[6];
+    public double[] Torques { get; set; } = new double[6];
+    public List<OperatingReading> OperatingReadings { get; } = [];
+    public int? ActiveAlarmCount { get; set; }
+    public object? StateData { get; set; }
+    public object? JobData { get; set; }
+    public object? IoData { get; set; }
+    public object? AlarmHistoryData { get; set; }
+    public object? SystemInfoData { get; set; }
+    public object[] ActiveAlarms { get; set; } = [];
+}
+
+internal static class ApiPayloads
+{
+    public const string TelemetryEndpoint = "/api/v1/collector/telemetry";
+    public const string OperatingEndpoint = "/api/v1/collector/operating-times";
+    public const string AlarmEndpoint = "/api/v1/collector/alarms/snapshots";
+    public const string ConnectionEndpoint = "/api/v1/collector/connections";
+    public static bool EndpointAllowed(string endpoint) => endpoint is TelemetryEndpoint or OperatingEndpoint or AlarmEndpoint or ConnectionEndpoint;
+    public static string Timestamp() => DateTimeOffset.UtcNow.ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'", CultureInfo.InvariantCulture);
+    public static string Json(object value) => JsonSerializer.Serialize(value);
+    public static string Text(string? value) => (value ?? "").Replace("\0", "", StringComparison.Ordinal);
+    public static Dictionary<string, object?> Map(params (string Key, object? Value)[] values) => values.ToDictionary(v => v.Key, v => v.Value);
+    public static object Availability(Reading r) => Map(("read_ok", r.Ok), ("status_code", r.Code), ("message", r.Error), ("raw", r.Ok ? r.Raw : null));
+    private static object Axes(double[] values)
+    {
+        if (values.Length < 6 || values.Take(6).Any(x => !double.IsFinite(x))) throw new InvalidDataException("Invalid axis values");
+        string[] axes = ["S", "L", "U", "R", "B", "T"];
+        return Enumerable.Range(0, 6).ToDictionary(i => axes[i], i => values[i]);
+    }
+    public static object Metadata(RobotSample s, bool mock, Device d) => Map(
+        ("simulated", mock), ("torque_unit", "sdk_raw"), ("position_unit", "pulses"), ("group", d.Group),
+        ("controller_state", s.StateData), ("job", s.JobData), ("system_info", s.SystemInfoData),
+        ("io_values", s.IoData), ("alarm_history", s.AlarmHistoryData),
+        ("state_read", Availability(s.State)), ("job_read", Availability(s.Job)),
+        ("io_read", Availability(s.Io)), ("alarm_history_read", Availability(s.AlarmHistory)));
+    public static string Telemetry(Device d, string session, long seq, string at, RobotSample s, bool mock) => Json(Map(
+        ("robot_id", d.Id), ("collector_session_id", session), ("sequence", seq), ("sampled_at", at),
+        ("position_ok", s.Position.Ok), ("position_status_code", s.Position.Code), ("position_status_message", s.Position.Error),
+        ("position_sampled_at", s.Position.Ok ? at : null), ("position_pulses", s.Position.Ok ? Axes(s.Pulses) : null),
+        ("torque_ok", s.Torque.Ok), ("torque_status_code", s.Torque.Code), ("torque_status_message", s.Torque.Error),
+        ("torque_sampled_at", s.Torque.Ok ? at : null), ("torque_axes", s.Torque.Ok ? Axes(s.Torques) : null),
+        ("torque_unit", "sdk_raw"), ("raw_payload", Metadata(s, mock, d))));
+    public static string Operating(Device d, string at, OperatingReading r, bool mock) => Json(Map(
+        ("robot_id", d.Id), ("time_type", r.Type), ("sampled_at", at), ("read_ok", r.Result.Ok),
+        ("status_code", r.Result.Code), ("status_message", r.Result.Error), ("value_raw", r.Result.Ok ? r.Result.Raw : null),
+        ("value_seconds", r.Result.Ok ? r.Seconds : null),
+        ("raw_payload", Map(("simulated", mock), ("duration_unit", "seconds"),
+            ("duration_source", "YMConnect TimeData.elapsedTime Hours/Minutes/Seconds")))));
+    public static string Alarms(Device d, string at, RobotSample s, bool mock) => Json(Map(
+        ("robot_id", d.Id), ("sampled_at", at), ("read_ok", s.Alarm.Ok), ("status_code", s.Alarm.Code),
+        ("status_message", s.Alarm.Error), ("sdk_text", s.Alarm.Ok ? s.Alarm.Raw : null),
+        ("active_alarm_count", s.Alarm.Ok ? s.ActiveAlarmCount : null), ("parsed_alarms", s.Alarm.Ok ? s.ActiveAlarms : null),
+        ("raw_payload", Map(("simulated", mock), ("active_alarms", s.Alarm.Ok ? s.ActiveAlarms : null),
+            ("alarm_history", s.AlarmHistoryData), ("alarm_history_read", Availability(s.AlarmHistory))))));
+    public static string Connection(Device d, string at, string state, bool mock) => Json(Map(
+        ("robot_id", d.Id), ("state", state), ("occurred_at", at), ("ip_address", d.Ip),
+        ("message", mock ? "MOCK TEST — NOT ACTUAL ROBOT" : "YMConnect collector status"),
+        ("raw_payload", Map(("simulated", mock), ("control_group", d.Group)))));
+}
diff --git a/src-csharp/Program.cs b/src-csharp/Program.cs
new file mode 100644
index 0000000000000000000000000000000000000000..e4cc987cb964d3d71f708ef6143f3501db3a2c27
--- /dev/null
+++ b/src-csharp/Program.cs
@@ -0,0 +1,164 @@
+using System.Diagnostics;
+using System.Text;
+
+namespace RmsCollector;
+
+internal static class AppLog
+{
+    private static readonly object Sync = new();
+    public static void Write(string text) { lock (Sync) Console.WriteLine(text); }
+}
+
+internal static class CollectorRunner
+{
+    public static async Task RunRobotAsync(CollectorConfig config, Device device, CliOptions options, string token,
+        CancellationToken cancellation, Func<Device, IRobotReader>? readerFactory = null)
+    {
+        using var reader = readerFactory?.Invoke(device) ?? (options.Mock ? (IRobotReader)new MockReader(device) : new YmConnectReader(device));
+        using var tx = new Dispatcher(config, device, options.DryRun, token);
+        string session = Guid.NewGuid().ToString();
+        long sequence = 0;
+        bool announced = false, failed = false;
+        int badSamples = 0;
+        TimeSpan nextOperating = TimeSpan.Zero, nextAlarm = TimeSpan.Zero, nextExtras = TimeSpan.Zero;
+        var clock = Stopwatch.StartNew();
+        AppLog.Write($"[RMS] robot_id={device.Id} ip={device.Ip} {(options.Mock ? "MOCK" : "REAL")} started");
+        try
+        {
+            while (!cancellation.IsCancellationRequested)
+            {
+                TimeSpan start = clock.Elapsed;
+                if (!reader.Connected && !reader.Connect())
+                {
+                    if (options.Once) throw new IOException($"YMConnect could not connect to robot {device.Id} at {device.Ip}");
+                    if (announced)
+                    {
+                        await tx.PostAsync(ApiPayloads.ConnectionEndpoint, ApiPayloads.Connection(device, ApiPayloads.Timestamp(), "offline", options.Mock), cancellation);
+                        announced = false;
+                    }
+                    await tx.FlushAsync(cancellation);
+                    await WaitUntilAsync(clock, start + TimeSpan.FromMilliseconds(config.TelemetryMs), cancellation);
+                    continue;
+                }
+                TimeSpan now = clock.Elapsed;
+                bool operating = now >= nextOperating, alarms = now >= nextAlarm, extras = now >= nextExtras;
+                var sample = reader.Collect(sequence, extras, operating, alarms);
+                bool good = sample.Position.Ok || sample.Torque.Ok;
+                string at = ApiPayloads.Timestamp();
+                if (good)
+                {
+                    badSamples = 0;
+                    if (!announced)
+                    {
+                        await tx.PostAsync(ApiPayloads.ConnectionEndpoint, ApiPayloads.Connection(device, at, "connected", options.Mock), cancellation);
+                        announced = true;
+                    }
+                }
+                else if (++badSamples >= 3)
+                {
+                    if (announced) await tx.PostAsync(ApiPayloads.ConnectionEndpoint, ApiPayloads.Connection(device, at, "offline", options.Mock), cancellation);
+                    announced = false;
+                    reader.Disconnect();
+                    badSamples = 0;
+                    AppLog.Write($"[YMConnect {device.Id}] disconnected after 3 consecutive cycles with no position or torque data");
+                }
+                if (options.Once && !good) throw new IOException($"No position or torque read succeeded for robot {device.Id}");
+                if (good) await tx.PostAsync(ApiPayloads.TelemetryEndpoint, ApiPayloads.Telemetry(device, session, sequence, at, sample, options.Mock), cancellation);
+                if (operating)
+                {
+                    foreach (var counter in sample.OperatingReadings)
+                        await tx.PostAsync(ApiPayloads.OperatingEndpoint, ApiPayloads.Operating(device, ApiPayloads.Timestamp(), counter, options.Mock), cancellation);
+                    nextOperating = now + TimeSpan.FromSeconds(config.OperatingSeconds);
+                }
+                if (alarms)
+                {
+                    await tx.PostAsync(ApiPayloads.AlarmEndpoint, ApiPayloads.Alarms(device, ApiPayloads.Timestamp(), sample, options.Mock), cancellation);
+                    nextAlarm = now + TimeSpan.FromSeconds(config.AlarmSeconds);
+                }
+                if (extras)
+                {
+                    nextExtras = now + TimeSpan.FromSeconds(config.ExtrasSeconds);
+                    if (!sample.State.Ok || !sample.Job.Ok || !sample.Io.Ok)
+                        AppLog.Write($"[SDK {device.Id}] extras: {sample.State.Error}; {sample.Job.Error}; {sample.Io.Error}");
+                }
+                await tx.FlushAsync(cancellation);
+                if (options.Once) break;
+                sequence++;
+                await WaitUntilAsync(clock, start + TimeSpan.FromMilliseconds(config.TelemetryMs), cancellation);
+            }
+        }
+        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
+        catch { failed = true; throw; }
+        finally
+        {
+            if (announced && !options.Once && !failed)
+            {
+                // Graceful Ctrl+C should preserve a final stopped record even if the API is offline.
+                try { await tx.PostAsync(ApiPayloads.ConnectionEndpoint, ApiPayloads.Connection(device, ApiPayloads.Timestamp(), "stopped", options.Mock), CancellationToken.None); }
+                catch (Exception e) { AppLog.Write($"[STOP {device.Id}] {e.Message}"); }
+            }
+        }
+    }
+
+    private static Task WaitUntilAsync(Stopwatch clock, TimeSpan target, CancellationToken cancellation)
+    {
+        TimeSpan remaining = target - clock.Elapsed;
+        return remaining > TimeSpan.Zero ? Task.Delay(remaining, cancellation) : Task.CompletedTask;
+    }
+}
+
+internal static class Program
+{
+    public static async Task<int> Main(string[] args)
+    {
+        Console.OutputEncoding = new UTF8Encoding(false);
+        try
+        {
+            var options = CliOptions.Parse(args);
+            if (options.Help)
+            {
+                Console.WriteLine("rms_collector --config config/collector.conf --mock|--real [--once] [--dry-run] [--robot-id N] [--allow-mock-post]\n" +
+                    "rms_collector --probe [--config config/collector.conf]\n" +
+                    "rms_collector --check-sdk\n\n" +
+                    "Mock POST is blocked unless explicitly allowed for a DEMO robot. REAL is read-only and requires Windows x64.\n" +
+                    "Relative config/token/spool paths are resolved from your working directory. Run from the project/publish folder.");
+                return 0;
+            }
+            if (options.CheckSdk)
+            {
+                YmConnectReader.CheckSdk();
+                AppLog.Write("[SDK] Matching Windows x64 managed/native DLLs load successfully. No robot connection was made.");
+                return 0;
+            }
+            var config = CollectorConfig.Load(options.ConfigPath);
+            using var stop = new CancellationTokenSource();
+            ConsoleCancelEventHandler cancel = (_, e) => { e.Cancel = true; stop.Cancel(); };
+            Console.CancelKeyPress += cancel;
+            try
+            {
+                if (options.Probe)
+                {
+                    using var api = new ApiClient(config, "");
+                    var result = await api.SendAsync("/up", null, stop.Token);
+                    AppLog.Write($"[PROBE] GET {config.ApiBase}/up => {result.Summary}");
+                    return result.Error is null && result.Status is >= 200 and < 400 ? 0 : 1;
+                }
+                var devices = config.Devices.Where(d => options.RobotId == 0 || d.Id == options.RobotId).ToArray();
+                if (devices.Length == 0) throw new ArgumentException("Selected robot_id not in config");
+                if (options.Real) YmConnectReader.CheckSdk();
+                string token = options.DryRun ? "" : config.ReadToken();
+                var tasks = devices.Select(device => Task.Run(async () =>
+                {
+                    try { await CollectorRunner.RunRobotAsync(config, device, options, token, stop.Token); }
+                    catch { stop.Cancel(); throw; }
+                }, CancellationToken.None)).ToArray();
+                await Task.WhenAll(tasks);
+                AppLog.Write("[RMS] Done");
+                return 0;
+            }
+            finally { Console.CancelKeyPress -= cancel; }
+        }
+        catch (OperationCanceledException) { AppLog.Write("[RMS] Stopped"); return 0; }
+        catch (Exception e) { Console.Error.WriteLine($"[ERROR] {e.Message}"); return 1; }
+    }
+}
