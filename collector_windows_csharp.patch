@@ -0,0 +1,53 @@
+namespace RmsCollector;
+
+internal interface IRobotReader : IDisposable
+{
+    bool Connected { get; }
+    bool Connect();
+    void Disconnect();
+    RobotSample Collect(long sequence, bool extras, bool operating, bool alarms);
+}
+
+internal sealed class MockReader(Device device) : IRobotReader
+{
+    public bool Connected { get; private set; }
+    public bool Connect() => Connected = true;
+    public void Disconnect() => Connected = false;
+    public void Dispose() => Disconnect();
+    public RobotSample Collect(long sequence, bool extras, bool operating, bool alarms)
+    {
+        var s = new RobotSample { Position = new(true, 0, "", "mock positions"), Torque = new(true, 0, "", "mock torque") };
+        for (int i = 0; i < 6; i++)
+        {
+            s.Pulses[i] = 100000 + i * 12000 + sequence * 5;
+            s.Torques[i] = 9 + i * 1.1 + 0.4 * Math.Sin(sequence * 0.25 + i);
+        }
+        if (operating)
+        {
+            foreach (var (name, hours) in new[] { ("ControllerOnTime", 223), ("ServoPowerOnTimeRobot", 123), ("PlayBackTimeRobot", 97), ("MovingTimeRobot", 81) })
+            {
+                long seconds = hours * 3600L + sequence * 5;
+                s.OperatingReadings.Add(new(name, new(true, 0, "", $"Elapsed Time: {seconds / 3600} Hours : {seconds / 60 % 60} Minutes : {seconds % 60} Seconds"), seconds));
+            }
+        }
+        if (alarms)
+        {
+            s.Alarm = new(true, 0, "", "mock: no alarms");
+            s.ActiveAlarmCount = 0;
+            s.AlarmHistory = new(true, 0, "", "mock: empty");
+            s.AlarmHistoryData = Array.Empty<object>();
+        }
+        s.State = new(true, 0, "", "SIMULATED");
+        s.StateData = ApiPayloads.Map(("known", true), ("servo_on", false), ("running", false), ("alarm", false),
+            ("hold", true), ("error", false), ("control_mode", "Teach"), ("cycle_mode", "Step"), ("source", "mock"));
+        if (extras)
+        {
+            s.Job = new(true, 0, "", "SIMULATED");
+            s.JobData = ApiPayloads.Map(("name", "MOCK_JOB"), ("line", 2), ("step", sequence % 50), ("speed_override_percent", 50), ("source", "mock"));
+            s.SystemInfoData = ApiPayloads.Map(("simulated", true));
+            s.Io = new(true, 0, "", "SIMULATED");
+            s.IoData = device.Io.ToDictionary(a => a.ToString(System.Globalization.CultureInfo.InvariantCulture), a => (sequence + a) % 256);
+        }
+        return s;
+    }
+}
diff --git a/src-csharp/Transport.cs b/src-csharp/Transport.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c4216e2371aa3c3ae2702097aa00794df1c309f4
--- /dev/null
+++ b/src-csharp/Transport.cs
@@ -0,0 +1,154 @@
+using System.Net.Http.Headers;
+using System.Text;
+using System.Text.Json;
+
+namespace RmsCollector;
+
+internal sealed record HttpResult(int Status, string Body, string? Error = null)
+{
+    public bool Ok => Error is null && Status is >= 200 and < 300;
+    public bool Fatal => Error is null && Status is >= 400 and < 500 && Status is not (408 or 425 or 429);
+    public string Summary => Error ?? Status.ToString(System.Globalization.CultureInfo.InvariantCulture);
+}
+
+internal sealed class ApiClient : IDisposable
+{
+    private readonly HttpClient client;
+    private readonly string apiBase;
+    private readonly string token;
+    public ApiClient(CollectorConfig config, string bearer, HttpMessageHandler? handler = null)
+    {
+        apiBase = config.ApiBase;
+        token = bearer;
+        client = new HttpClient(handler ?? new SocketsHttpHandler { AllowAutoRedirect = false, ConnectTimeout = TimeSpan.FromSeconds(3), UseProxy = false })
+        { Timeout = TimeSpan.FromSeconds(config.HttpTimeoutSeconds), MaxResponseContentBufferSize = 64 * 1024 };
+    }
+    public async Task<HttpResult> SendAsync(string endpoint, string? json, CancellationToken cancellation)
+    {
+        if (json is not null && !ApiPayloads.EndpointAllowed(endpoint)) throw new InvalidDataException("Unsafe endpoint");
+        if (json is null && endpoint != "/up") throw new InvalidDataException("Unsafe probe endpoint");
+        using var request = new HttpRequestMessage(json is null ? HttpMethod.Get : HttpMethod.Post, apiBase + endpoint);
+        request.Headers.Accept.Add(new("application/json"));
+        if (json is not null)
+        {
+            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
+            request.Content = new StringContent(json, Encoding.UTF8, "application/json");
+        }
+        try
+        {
+            // ResponseContentRead keeps the request timeout active while receiving the body.
+            // Responses are expected to be small JSON; never log bearer tokens.
+            using var response = await client.SendAsync(request, cancellation).ConfigureAwait(false);
+            string body = await response.Content.ReadAsStringAsync(cancellation).ConfigureAwait(false);
+            return new((int)response.StatusCode, body[..Math.Min(body.Length, 4096)]);
+        }
+        catch (OperationCanceledException) when (!cancellation.IsCancellationRequested) { return new(0, "", "HTTP timeout"); }
+        catch (HttpRequestException e) { return new(0, "", e.Message); }
+    }
+    public void Dispose() => client.Dispose();
+}
+
+internal sealed class Dispatcher : IDisposable
+{
+    private readonly CollectorConfig config;
+    private readonly Device device;
+    private readonly bool dryRun;
+    private readonly ApiClient? http;
+    private readonly FileStream? ownerLock;
+    private long counter;
+    public string QueueDirectory { get; }
+    private static readonly UTF8Encoding Utf8 = new(false, true);
+
+    public Dispatcher(CollectorConfig config, Device device, bool dryRun, string token, HttpMessageHandler? handler = null)
+    {
+        this.config = config;
+        this.device = device;
+        this.dryRun = dryRun;
+        QueueDirectory = Path.Combine(config.SpoolDirectory, device.Id.ToString(System.Globalization.CultureInfo.InvariantCulture));
+        if (dryRun) return;
+        Directory.CreateDirectory(QueueDirectory);
+        // Fail if another C# collector already owns this robot's spool.
+        ownerLock = new FileStream(Path.Combine(QueueDirectory, ".collector.lock"), FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
+        http = new(config, token, handler);
+    }
+
+    private string[] QueuedFiles() => Directory.GetFiles(QueueDirectory, "*.queue", SearchOption.TopDirectoryOnly)
+        .OrderBy(p => Path.GetFileName(p), StringComparer.Ordinal).ToArray();
+
+    private string Save(string endpoint, string json, bool rejected = false)
+    {
+        if (!rejected && QueuedFiles().Length >= config.SpoolMax)
+            throw new IOException("Queue full; collector stops instead of silently dropping data");
+        string targetDirectory = rejected ? Path.Combine(QueueDirectory, "rejected") : QueueDirectory;
+        Directory.CreateDirectory(targetDirectory);
+        long micros = (DateTimeOffset.UtcNow.UtcTicks - DateTimeOffset.UnixEpoch.UtcTicks) / 10;
+        string name = $"{micros:D16}_{counter++:D6}_{Guid.NewGuid():N}.queue";
+        string path = Path.Combine(targetDirectory, name), temp = path + ".tmp";
+        try
+        {
+            using (var stream = new FileStream(temp, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+            using (var writer = new StreamWriter(stream, Utf8, leaveOpen: true))
+            {
+                writer.Write(endpoint + "\n" + json + "\n");
+                writer.Flush();
+                stream.Flush(flushToDisk: true);
+            }
+            File.Move(temp, path);
+        }
+        catch { if (File.Exists(temp)) File.Delete(temp); throw; }
+        return path;
+    }
+
+    private void Validate(string endpoint, string json)
+    {
+        if (!ApiPayloads.EndpointAllowed(endpoint)) throw new InvalidDataException("Unsafe queue endpoint");
+        using var value = JsonDocument.Parse(json);
+        if (value.RootElement.ValueKind != JsonValueKind.Object || !value.RootElement.TryGetProperty("robot_id", out var robot) ||
+            !robot.TryGetInt32(out int id) || id != device.Id) throw new InvalidDataException("Queue payload robot_id does not match this robot");
+    }
+
+    public async Task PostAsync(string endpoint, string json, CancellationToken cancellation)
+    {
+        Validate(endpoint, json);
+        if (dryRun) { AppLog.Write($"[DRY id={device.Id}] POST {endpoint} {json}"); return; }
+        // Preserve existing backlog order. A newer sample must not overtake old samples.
+        if (QueuedFiles().Length > 0) { Save(endpoint, json); return; }
+        HttpResult result;
+        try { result = await http!.SendAsync(endpoint, json, cancellation).ConfigureAwait(false); }
+        catch (OperationCanceledException) { Save(endpoint, json); throw; }
+        if (result.Ok) { AppLog.Write($"[API {device.Id}] {endpoint} => {result.Summary}"); return; }
+        string saved = Save(endpoint, json, result.Fatal);
+        if (result.Fatal)
+            throw new InvalidOperationException($"Laravel rejected POST: HTTP {result.Summary}. Payload preserved at {saved}. Check token/robot ID/API validation. {result.Body[..Math.Min(result.Body.Length, 800)]}");
+        AppLog.Write($"[SPOOL {device.Id}] {endpoint} failed {result.Summary}");
+    }
+
+    public async Task FlushAsync(CancellationToken cancellation)
+    {
+        if (dryRun) return;
+        foreach (string path in QueuedFiles().Take(10))
+        {
+            cancellation.ThrowIfCancellationRequested();
+            var file = new FileInfo(path);
+            if (file.Length > 1024 * 1024) throw new InvalidDataException($"Queue file is too large: {path}");
+            string[] lines = await File.ReadAllLinesAsync(path, Utf8, cancellation).ConfigureAwait(false);
+            if (lines.Length != 2) throw new InvalidDataException($"Invalid queue file: {path}");
+            string endpoint = lines[0], json = lines[1];
+            Validate(endpoint, json);
+            var result = await http!.SendAsync(endpoint, json, cancellation).ConfigureAwait(false);
+            if (result.Ok) { File.Delete(path); AppLog.Write($"[REPLAY {device.Id}] HTTP {result.Summary}"); continue; }
+            if (result.Status == 422 && result.Error is null)
+            {
+                string directory = Path.Combine(QueueDirectory, "rejected");
+                Directory.CreateDirectory(directory);
+                File.Move(path, Path.Combine(directory, Path.GetFileName(path)));
+                AppLog.Write($"[QUARANTINE {device.Id}] HTTP 422 {path}");
+                continue;
+            }
+            if (result.Fatal) throw new InvalidOperationException($"Queue replay blocked: HTTP {result.Summary}. Original file retained: {path}");
+            break;
+        }
+    }
+
+    public void Dispose() { http?.Dispose(); ownerLock?.Dispose(); }
+}
diff --git a/src-csharp/YmConnectReader.cs b/src-csharp/YmConnectReader.cs
new file mode 100644
index 0000000000000000000000000000000000000000..efcacfbcc67986635dafd183d094039775dba2f5
--- /dev/null
+++ b/src-csharp/YmConnectReader.cs
@@ -0,0 +1,186 @@
+using System.Globalization;
+using System.Runtime.InteropServices;
+using YMConnect;
+
+namespace RmsCollector;
+
+// Only read APIs are used here. The collector never commands motion, servo power,
+// job execution, parameter changes or IO writes.
+internal sealed class YmConnectReader(Device device) : IRobotReader
+{
+    private MotomanController? controller;
+    public bool Connected => controller is not null;
+
+    public static void CheckSdk()
+    {
+        if (!OperatingSystem.IsWindows() || RuntimeInformation.ProcessArchitecture != Architecture.X64)
+            throw new PlatformNotSupportedException("REAL requires Windows x64. Mock/probe can run on other platforms.");
+        string native = Path.Combine(AppContext.BaseDirectory, "YMConnect.dll");
+        if (!File.Exists(native)) throw new FileNotFoundException("YMConnect.dll is missing beside rms_collector.exe", native);
+        try
+        {
+            nint handle = NativeLibrary.Load(native);
+            NativeLibrary.Free(handle);
+            _ = typeof(MotomanController).Assembly.GetName();
+        }
+        catch (Exception e) when (e is DllNotFoundException or BadImageFormatException)
+        {
+            throw new InvalidOperationException("Cannot load the official Windows x64 YMConnect SDK. Install the supported Visual C++ v14 Redistributable x64 and keep the matching YMConnect.dll/YMConnect_CS.dll pair together. MSVC Build Tools are not needed.", e);
+        }
+    }
+
+    public bool Connect()
+    {
+        Disconnect();
+        var candidate = MotomanController.OpenConnection(device.Ip, out StatusInfo status);
+        if (status.StatusCode != 0 || candidate is null)
+        {
+            candidate?.CloseConnection();
+            AppLog.Write($"[YMConnect {device.Ip}] OPEN FAILED code={status.StatusCode}");
+            return false;
+        }
+        controller = candidate;
+        AppLog.Write($"[YMConnect] Connected {device.Ip}");
+        return true;
+    }
+
+    public void Disconnect()
+    {
+        var previous = controller;
+        controller = null;
+        previous?.CloseConnection();
+    }
+    public void Dispose() => Disconnect();
+    private static Reading Result(StatusInfo status, string failure, string raw = "") =>
+        new(status.StatusCode == 0, status.StatusCode, status.StatusCode == 0 ? "" : failure, status.StatusCode == 0 ? raw : "");
+
+    public RobotSample Collect(long sequence, bool extras, bool operating, bool alarms)
+    {
+        var c = controller ?? throw new InvalidOperationException("Not connected to robot");
+        var s = new RobotSample();
+        var ps = c.ControlGroup.ReadPositionData(ControlGroupId.R1, CoordinateType.Pulse, 0, 0, out PositionData position);
+        s.Position = Result(ps, "YMConnect position read failed");
+        if (s.Position.Ok)
+        {
+            if (position.AxisData is not { Length: >= 6 } || position.AxisData.Take(6).Any(v => !double.IsFinite(v)))
+                s.Position = new(false, -1, "Invalid position axis data from SDK");
+            else s.Pulses = position.AxisData.Take(6).ToArray();
+        }
+        var ts = c.ControlGroup.ReadTorqueData(ControlGroupId.R1, out TorqueData torque);
+        s.Torque = Result(ts, "YMConnect torque read failed");
+        if (s.Torque.Ok)
+        {
+            if (torque.AxisData is not { Length: >= 6 }) s.Torque = new(false, -1, "Invalid torque axis data from SDK");
+            else s.Torques = torque.AxisData.Take(6).Select(v => (double)v).ToArray();
+        }
+        if (operating) ReadOperating(c, s);
+        if (alarms) ReadAlarms(c, s);
+
+        // State must be refreshed at the telemetry rate, not only at extras rate.
+        var stateStatus = c.Status.ReadState(out ControllerStateData state);
+        s.State = Result(stateStatus, "YMConnect state read failed");
+        if (s.State.Ok)
+        {
+            s.StateData = ApiPayloads.Map(("known", true), ("running", state.IsRunning), ("servo_on", state.IsServoOn),
+                ("alarm", state.IsAlarming), ("hold", state.IsInHold), ("error", state.IsErroring),
+                ("control_mode", Enum.IsDefined(state.ControlMode) ? state.ControlMode.ToString() : "Unknown"),
+                ("cycle_mode", Enum.IsDefined(state.CycleMode) ? state.CycleMode.ToString() : "Unknown"));
+            s.State = s.State with { Raw = ApiPayloads.Json(s.StateData) };
+        }
+        if (extras) ReadExtras(c, s);
+        return s;
+    }
+
+    private static void ReadOperating(MotomanController c, RobotSample s)
+    {
+        foreach (TimeType type in new[] { TimeType.ControllerOnTime, TimeType.ServoPowerOnTimeRobot, TimeType.PlayBackTimeRobot, TimeType.MovingTimeRobot })
+        {
+            var status = c.Status.ReadOperatingTimes(ControlGroupId.R1, type, out TimeData data, ApplicationNumber.ApplicationOne);
+            Reading result = Result(status, "Operating time read failed");
+            long? seconds = null;
+            if (result.Ok)
+            {
+                var elapsed = data.ElapsedTime;
+                if (elapsed.Minutes >= 60 || elapsed.Seconds >= 60) result = new(false, -1, "YMConnect elapsed time components are out of range");
+                else
+                {
+                    seconds = checked((long)elapsed.Hours * 3600 + elapsed.Minutes * 60L + elapsed.Seconds);
+                    result = result with { Raw = FormattableString.Invariant($"Elapsed Time: {elapsed.Hours} Hours : {elapsed.Minutes} Minutes : {elapsed.Seconds} Seconds") };
+                }
+            }
+            s.OperatingReadings.Add(new(type.ToString(), result, seconds));
+        }
+    }
+
+    private static object AlarmObject(AlarmData alarm) => ApiPayloads.Map(
+        ("alarm_code", alarm.Code.ToString(CultureInfo.InvariantCulture)), ("subcode", alarm.Subcode.ToString(CultureInfo.InvariantCulture)),
+        ("alarm_name", ApiPayloads.Text(alarm.Name)), ("controller_time_raw", ApiPayloads.Text(alarm.Time)));
+
+    private static void ReadAlarms(MotomanController c, RobotSample s)
+    {
+        var status = c.Faults.GetActiveAlarms(out ActiveAlarms active);
+        s.Alarm = Result(status, "Active alarm read failed");
+        if (s.Alarm.Ok)
+        {
+            if (active.Count < 0 || active.Count > (active.Alarms?.Length ?? 0))
+                s.Alarm = new(false, -1, "Invalid active alarm count from SDK");
+            else
+            {
+                s.ActiveAlarmCount = active.Count;
+                s.ActiveAlarms = (active.Alarms ?? []).Take(active.Count).Select(AlarmObject).ToArray();
+                string text = active.Count == 0 ? "No active alarms." : $"{active.Count} alarm{(active.Count == 1 ? "" : "s")} active.";
+                foreach (var (a, i) in (active.Alarms ?? []).Take(active.Count).Select((a, i) => (a, i)))
+                    text += $"\nAlarm {i + 1}: Code: {a.Code}\nSubcode: {a.Subcode}\nName: {ApiPayloads.Text(a.Name)}\nTime: {ApiPayloads.Text(a.Time)}";
+                s.Alarm = s.Alarm with { Raw = text };
+            }
+        }
+        var categories = new List<object>();
+        bool allOk = true, anyOk = false;
+        foreach (AlarmCategory category in Enum.GetValues<AlarmCategory>())
+        {
+            var result = c.Faults.GetAlarmHistory(category, 20, out AlarmHistory history);
+            bool ok = result.StatusCode == 0;
+            int count = ok ? Math.Min(Math.Max(history.NumberOfAlarmsFetched, 0), history.Alarms?.Length ?? 0) : 0;
+            allOk &= ok;
+            anyOk |= ok;
+            categories.Add(ApiPayloads.Map(("category", category.ToString()), ("read_ok", ok), ("status_code", result.StatusCode),
+                ("requested_count", 20), ("fetched_count", ok ? count : null),
+                ("alarms", ok ? (history.Alarms ?? []).Take(count).Select(AlarmObject).ToArray() : Array.Empty<object>())));
+        }
+        s.AlarmHistoryData = ApiPayloads.Map(("requested_per_category", 20), ("categories", categories));
+        s.AlarmHistory = new(allOk, allOk ? 0 : -1, allOk ? "" : anyOk ? "Some alarm history categories failed" : "All alarm history category reads failed",
+            ApiPayloads.Json(s.AlarmHistoryData));
+    }
+
+    private void ReadExtras(MotomanController c, RobotSample s)
+    {
+        var info = new Dictionary<string, object?>();
+        foreach (var (name, id) in new[] { ("robot_r1", SystemInfoId.R1), ("station_s1", SystemInfoId.S1), ("application_a1", SystemInfoId.A1) })
+        {
+            var status = c.Status.ReadSystemInformation(id, out SystemInfoData data);
+            bool ok = status.StatusCode == 0;
+            info[name] = ApiPayloads.Map(("read_ok", ok), ("status_code", status.StatusCode),
+                ("model_name", ok ? ApiPayloads.Text(data.ModelName) : null), ("software_version", ok ? ApiPayloads.Text(data.SoftwareVersion) : null));
+        }
+        s.SystemInfoData = info;
+        var jobStatus = c.Job.GetExecutingJobInformation(InformTaskNumber.Master, out JobData job);
+        s.Job = Result(jobStatus, "YMConnect job read failed", jobStatus.StatusCode == 0 ? ApiPayloads.Text(job.Name) : "");
+        if (s.Job.Ok)
+            s.JobData = ApiPayloads.Map(("name", ApiPayloads.Text(job.Name)), ("line", job.Line), ("step", job.StepNumber),
+                ("speed_override_percent", job.SpeedOverride), ("task", "Master"));
+
+        if (device.Io.Length == 0) { s.Io = new(false, -1, "No IO addresses configured"); return; }
+        var values = new Dictionary<string, object?>();
+        bool allOk = true;
+        foreach (int address in device.Io)
+        {
+            var status = c.IO.ReadByte((uint)address, out IOByteData value);
+            bool ok = status.StatusCode == 0;
+            allOk &= ok;
+            values[address.ToString(CultureInfo.InvariantCulture)] = ApiPayloads.Map(("read_ok", ok), ("status_code", status.StatusCode),
+                ("sdk_raw_text", ok ? Convert.ToString(value.ToByte(), 2).PadLeft(8, '0') : null));
+        }
+        s.IoData = values;
+        s.Io = new(allOk, allOk ? 0 : -1, allOk ? "" : "Some IO address reads failed", ApiPayloads.Json(values));
+    }
+}
diff --git a/tests/Program.cs b/tests/Program.cs
new file mode 100644
index 0000000000000000000000000000000000000000..f249fcf089f8cec1a14715b290b063536a01ba9c
--- /dev/null
+++ b/tests/Program.cs
@@ -0,0 +1,205 @@
+using System.Net;
+using System.Text.Json;
+using RmsCollector;
+
+static class Tests
+{
+    private static int passed;
+    static void Assert(bool value, string message) { if (!value) throw new Exception(message); }
+    static async Task Throws(Func<Task> work, string message)
+    {
+        try { await work(); } catch { return; }
+        throw new Exception("Expected failure: " + message);
+    }
+    static Task Throws(Action work, string message) => Throws(() => { work(); return Task.CompletedTask; }, message);
+    static async Task Test(string name, Func<Task> work)
+    {
+        await work();
+        Console.WriteLine("PASS " + name);
+        passed++;
+    }
+
+    static async Task Main()
+    {
+        string root = Path.Combine(Path.GetTempPath(), "rms-tests-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(root);
+        try
+        {
+            CollectorConfig Config(string name = "default", string extra = "")
+            {
+                string path = Path.Combine(root, name + ".conf");
+                File.WriteAllText(path, $"api_base=http://127.0.0.1:8080\nspool_dir={root.Replace('\\', '/')}/{name}\nrobot=1,192.168.255.1,R1,10;10010\n" + extra);
+                return CollectorConfig.Load(path);
+            }
+            var config = Config();
+            var device = config.Devices[0];
+            using var mock = new MockReader(device);
+            mock.Connect();
+            var sample = mock.Collect(0, true, true, true);
+            const string at = "2026-11-08T01:02:03.123Z";
+            const string session = "1abcb350-fd84-45f5-9193-4cecb3180391";
+            string telemetry = ApiPayloads.Telemetry(device, session, 0, at, sample, true);
+
+            await Test("CLI blocks ambiguous modes and accidental mock POST", async () =>
+            {
+                await Throws(() => CliOptions.Parse(["--mock"]), "unapproved mock write");
+                await Throws(() => CliOptions.Parse(["--mock", "--real", "--dry-run"]), "two modes");
+                await Throws(() => CliOptions.Parse(["--robot-id"]), "missing option value");
+                await Throws(() => CliOptions.Parse(["--mock", "--probe", "--dry-run"]), "probe with read mode");
+                Assert(CliOptions.Parse(["--mock", "--dry-run"]).Mock, "mock dry run should work");
+            });
+            await Test("Config preserves DOJO format and validates identities and intervals", async () =>
+            {
+                Assert(device.Io.SequenceEqual([10, 10010]), "IO parse mismatch");
+                await Throws(() => Config("duplicate", "robot=1,192.168.255.2,R1\n"), "duplicate robot");
+                await Throws(() => Config("rate", "telemetry_ms=0\n"), "invalid polling interval");
+                await Throws(() => Config("group", "robot=2,192.168.255.2,R2\n"), "unsupported group");
+                Assert(Config("comment", "// sample comment\n").Devices.Count == 1, "legacy sample comment");
+                await Throws(() => Config("unknown", "invalid_key=1\n"), "typo in config");
+            });
+            await Test("Telemetry matches Laravel fields, UTC, SLURBT and simulated evidence", () =>
+            {
+                using var j = JsonDocument.Parse(telemetry);
+                var o = j.RootElement;
+                Assert(o.GetProperty("collector_session_id").GetString() == session && o.GetProperty("sequence").GetInt64() == 0, "idempotency keys");
+                Assert(o.GetProperty("sampled_at").GetString() == at, "timezone timestamp");
+                Assert(o.GetProperty("position_pulses").EnumerateObject().Select(x => x.Name).SequenceEqual(["S", "L", "U", "R", "B", "T"]), "axes");
+                Assert(o.GetProperty("torque_unit").GetString() == "sdk_raw", "no invented torque conversion");
+                var raw = o.GetProperty("raw_payload");
+                Assert(raw.GetProperty("simulated").GetBoolean(), "mock must be labeled");
+                Assert(!raw.GetProperty("controller_state").GetProperty("servo_on").GetBoolean(), "servo state");
+                return Task.CompletedTask;
+            });
+            await Test("Missing reads stay null and zero alarms stay zero", () =>
+            {
+                sample.Position = new(false, 99, "failed");
+                using var t = JsonDocument.Parse(ApiPayloads.Telemetry(device, session, 0, at, sample, true));
+                Assert(t.RootElement.GetProperty("position_pulses").ValueKind == JsonValueKind.Null, "missing pulses became zero");
+                using var a = JsonDocument.Parse(ApiPayloads.Alarms(device, at, sample, true));
+                Assert(a.RootElement.GetProperty("active_alarm_count").GetInt32() == 0, "zero count lost");
+                sample.Position = new(true, 0, "");
+                return Task.CompletedTask;
+            });
+            await Test("All four operating counters preserve integer seconds and diagnostic text", () =>
+            {
+                Assert(sample.OperatingReadings.Count == 4, "missing counters");
+                foreach (var op in sample.OperatingReadings)
+                {
+                    using var j = JsonDocument.Parse(ApiPayloads.Operating(device, at, op, true));
+                    Assert(j.RootElement.GetProperty("value_seconds").GetInt64() == op.Seconds, "integer counter");
+                    Assert(j.RootElement.GetProperty("value_raw").GetString()!.Contains("Hours :"), "backend parser input");
+                }
+                return Task.CompletedTask;
+            });
+            await Test("UTF8 JSON preserves Japanese text and strips embedded NUL", () =>
+            {
+                using var j = JsonDocument.Parse(ApiPayloads.Json(new { text = ApiPayloads.Text("警報\0ロボット") }));
+                Assert(j.RootElement.GetProperty("text").GetString() == "警報ロボット", "SDK text corrupt");
+                return Task.CompletedTask;
+            });
+            await Test("Outage queues, backlog stays FIFO, replay sends the exact body once", async () =>
+            {
+                var c = Config("offline");
+                var requests = new List<string>();
+                int status = 503;
+                using var tx = new Dispatcher(c, device, false, "test-token", new Handler(async (req, ct) =>
+                {
+                    Assert(req.Headers.Authorization?.ToString() == "Bearer test-token", "authentication header");
+                    requests.Add(await req.Content!.ReadAsStringAsync(ct));
+                    return new((HttpStatusCode)status) { Content = new StringContent("{}") };
+                }));
+                await tx.PostAsync(ApiPayloads.TelemetryEndpoint, telemetry, default);
+                string second = ApiPayloads.Telemetry(device, session, 1, at, sample, true);
+                await tx.PostAsync(ApiPayloads.TelemetryEndpoint, second, default);
+                Assert(requests.Count == 1 && Directory.GetFiles(tx.QueueDirectory, "*.queue").Length == 2, "backlog overtaken");
+                status = 201;
+                await tx.FlushAsync(default);
+                Assert(requests.Skip(1).SequenceEqual([telemetry, second]), "out of order or rewritten payload");
+                Assert(Directory.GetFiles(tx.QueueDirectory, "*.queue").Length == 0, "acknowledged queue retained");
+            });
+            await Test("Permanent POST rejection is preserved and stops collection", async () =>
+            {
+                using var tx = new Dispatcher(Config("rejected"), device, false, "t", Handler.Status(401));
+                await Throws(() => tx.PostAsync(ApiPayloads.TelemetryEndpoint, telemetry, default), "permanent rejection");
+                Assert(Directory.GetFiles(Path.Combine(tx.QueueDirectory, "rejected"), "*.queue").Length == 1, "rejected body lost");
+            });
+            await Test("Legacy two-line queue replays and quarantines old HTTP422 payloads", async () =>
+            {
+                using var tx = new Dispatcher(Config("legacy"), device, false, "t", Handler.Status(422));
+                string path = Path.Combine(tx.QueueDirectory, "1792553210411295_0.queue");
+                File.WriteAllText(path, ApiPayloads.TelemetryEndpoint + "\n" + telemetry + "\n");
+                await tx.FlushAsync(default);
+                Assert(!File.Exists(path) && File.Exists(Path.Combine(tx.QueueDirectory, "rejected", Path.GetFileName(path))), "legacy quarantine failed");
+            });
+            await Test("Corrupt or cross-robot queues never reach HTTP", async () =>
+            {
+                int sent = 0;
+                using var tx = new Dispatcher(Config("invalid"), device, false, "t", new Handler((req, ct) =>
+                { sent++; return Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK)); }));
+                string path = Path.Combine(tx.QueueDirectory, "invalid.queue");
+                File.WriteAllText(path, "http://other-server/unsafe\n" + telemetry + "\n");
+                await Throws(() => tx.FlushAsync(default), "unsafe endpoint");
+                File.WriteAllText(path, ApiPayloads.TelemetryEndpoint + "\n{\"robot_id\":2}\n");
+                await Throws(() => tx.FlushAsync(default), "wrong robot");
+                Assert(sent == 0 && File.Exists(path), "invalid queue sent or discarded");
+            });
+            await Test("Cancellation retains a request for replay and queue is single-owner", async () =>
+            {
+                var c = Config("cancel");
+                using var tx = new Dispatcher(c, device, false, "t", new Handler((req, ct) => Task.FromCanceled<HttpResponseMessage>(ct)));
+                await Throws(() => { using var other = new Dispatcher(c, device, false, "t"); }, "two collectors sharing spool");
+                using var stop = new CancellationTokenSource(); stop.Cancel();
+                await Throws(() => tx.PostAsync(ApiPayloads.TelemetryEndpoint, telemetry, stop.Token), "cancelled post");
+                Assert(Directory.GetFiles(tx.QueueDirectory, "*.queue").Length == 1, "cancelled sample lost");
+            });
+            await Test("Queue capacity stops instead of deleting old samples", async () =>
+            {
+                using var tx = new Dispatcher(Config("full", "spool_max=100\n"), device, false, "t", Handler.Status(503));
+                for (int i = 0; i < 100; i++) await tx.PostAsync(ApiPayloads.TelemetryEndpoint, telemetry, default);
+                await Throws(() => tx.PostAsync(ApiPayloads.TelemetryEndpoint, telemetry, default), "full queue");
+                Assert(Directory.GetFiles(tx.QueueDirectory, "*.queue").Length == 100, "old samples were dropped");
+            });
+            await Test("Dry-run never creates a spool or invokes HTTP", async () =>
+            {
+                var c = Config("dry");
+                using var tx = new Dispatcher(c, device, true, "", new Handler((req, ct) => throw new Exception("network in dry-run")));
+                await tx.PostAsync(ApiPayloads.TelemetryEndpoint, telemetry, default);
+                await tx.FlushAsync(default);
+                Assert(!Directory.Exists(c.SpoolDirectory), "dry-run wrote to disk");
+            });
+            await Test("Three bad reads disconnect and next connection recovers", async () =>
+            {
+                var reader = new FlakyReader();
+                using var stop = new CancellationTokenSource(TimeSpan.FromSeconds(7));
+                var opts = CliOptions.Parse(["--mock", "--dry-run"]);
+                await CollectorRunner.RunRobotAsync(Config("reconnect", "telemetry_ms=1000\n"), device, opts, "", stop.Token, _ => reader);
+                Assert(reader.Connections >= 2 && reader.Disconnects >= 1 && reader.SawRecovery, "reconnection state machine");
+            });
+            Console.WriteLine($"PASS {passed} tests");
+        }
+        finally { Directory.Delete(root, recursive: true); }
+    }
+
+    private sealed class Handler(Func<HttpRequestMessage, CancellationToken, Task<HttpResponseMessage>> action) : HttpMessageHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken) => action(request, cancellationToken);
+        public static Handler Status(int code) => new((req, ct) => Task.FromResult(new HttpResponseMessage((HttpStatusCode)code) { Content = new StringContent("{}") }));
+    }
+    private sealed class FlakyReader : IRobotReader
+    {
+        private int cycle;
+        public int Connections, Disconnects;
+        public bool SawRecovery;
+        public bool Connected { get; private set; }
+        public bool Connect() { Connections++; return Connected = true; }
+        public void Disconnect() { Disconnects++; Connected = false; }
+        public void Dispose() => Disconnect();
+        public RobotSample Collect(long sequence, bool extras, bool operating, bool alarms)
+        {
+            cycle++;
+            if (cycle is >= 2 and <= 4) return new RobotSample();
+            if (cycle > 4) SawRecovery = true;
+            return new() { Position = new(true, 0, "") };
+        }
+    }
+}
